<?xml version="1.0" encoding="utf-8"?>
<!-- Back up the study database and settings with the user's Android backup, so data survives a phone change. -->
<full-backup-content>
    <include domain="database" path="milestone.db" />
    <include domain="database" path="milestone.db-wal" />
    <include domain="database" path="milestone.db-shm" />
    <include domain="sharedpref" path="user.xml" />
</full-backup-content>
